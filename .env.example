# HackJos 2026 - Supabase connection
# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase project URL, from Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key (NOT the service_role key).
# This key is safe to use in a browser; access is controlled by RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Passcode for the admin dashboard at #/admin.
# Vite inlines VITE_* values into the built JavaScript, so this is NOT a
# substitute for real authentication. See README for recommendations.
VITE_ADMIN_PASSCODE=your-passcode-here
